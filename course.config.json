{
  "schema_version": 2,
  "repository": "alextgtome/complete-english",
  "branch": "develop",
  "timezone": "America/Sao_Paulo",
  "start_date": "2026-10-29",
  "total_days": 150,
  "daily_minutes": {
    "foundations": 15,
    "chunks": 35,
    "speaking": 30,
    "writing": 10
  },
  "chunk_policy": {
    "new_per_day": 3,
    "review_per_day": 3,
    "strict_from_day": 17
  },
  "historical_exceptions": {
    "1": {
      "new_count": 7
    },
    "7": {
      "new_count": 1
    },
    "12": {
      "new_count": 2
    }
  },
  "lesson_path_pattern": "lessons/day-NNN.html",
  "registry": "data/lessons.js",
  "spec": "docs/COURSE_SPEC.md",
  "runbook": "docs/DAILY_RUNBOOK.md",
  "speaking_mix": {
    "everyday_scenario_days_per_seven": 3,
    "workplace_scenario_days_per_seven": 2,
    "interview_scenario_days_per_seven": 2,
    "scenario_type_by_modulo_7": {
      "0": "everyday",
      "1": "interview",
      "2": "workplace",
      "3": "everyday",
      "4": "interview",
      "5": "workplace",
      "6": "everyday"
    },
    "prospective_from_day": 18,
    "unexpected_everyday_small_talk_each_day": true,
    "idea_generation_scaffold": "short truthful answer → one detail → optional return question",
    "workplace_topic_examples": [
      "AWS deployment and rollback",
      "service selection (Lambda/ECS/EKS)",
      "API contracts and versioning",
      "messaging and asynchronous integration",
      "CI/CD and release",
      "monitoring and incident communication",
      "architecture trade-offs and technical decisions",
      "code review and team collaboration"
    ]
  }
}
